{
  "domain": "librescoot_ble_client",
  "name": "Librescoot-BLE-Client",
  "version": "1.0.12",
  "documentation": "https://github.com/dtill/librescoot-homeassistant",
  "issue_tracker": "https://github.com/dtill/librescoot-homeassistant/issues",
  "codeowners": [
    "@dtill"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "panel_custom",
    "websocket_api"
  ],
  "after_dependencies": [
    "esphome"
  ],
  "iot_class": "local_polling",
  "requirements": [
    "icmplib==3.0.4"
  ],
  "zeroconf": [
    {
      "type": "_esphomelib._tcp.local.",
      "properties": {
        "project_name": "librescoot.ble_client"
      }
    }
  ]
}
